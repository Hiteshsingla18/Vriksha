# Shadow Candidate Audit Engine Configuration

APP_NAME="Vriksha Shadow Candidate Audit Engine"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_USER=vriksha
POSTGRES_PASSWORD=vriksha_secret
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vriksha_audit_db
DATABASE_URL=postgresql+asyncpg://vriksha:vriksha_secret@localhost:5432/vriksha_audit_db

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vrikshagraph

# Redis & Celery Worker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ML Models & Data Paths
SPACY_MODEL="en_core_web_sm"
SENTENCE_TRANSFORMER_MODEL="all-MiniLM-L6-v2"
DATA_DIR="./data"
